# Kafka settings from Assignment 2
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=orders-topic
KAFKA_GROUP=orders-dashboard-consumer

# MongoDB Atlas connection string
# Example: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=retail_streaming
MONGODB_COLLECTION=orders

# Live dashboard settings
DASHBOARD_REFRESH_SECONDS=3
PRODUCER_INTERVAL_SECONDS=1
